# Скопируйте в .env и подставьте значения (файл .env в .gitignore).
# Секреты НЕ хранятся в config.yaml и в исходном коде (ТЗ §19, §55).
# Все эндпоинты — локальные или научные API; облачные LLM API запрещены (§95).

# --- Поисковые/научные источники (все опциональны) ---
# PubMed (NCBI E-utilities): без ключа работает с пониженным rate limit (3/с).
NCBI_API_KEY=

# Crossref: polite pool — contact-адрес для повышенного лимита.
CROSSREF_MAILTO=

# Europe PMC — публичный REST API, ключ не требуется.

# DuckDuckGo web search (RESEARCH MODE) — без ключа.

# --- Локальная LLM (адреса задаются в config/config.yaml, не здесь) ---
# llama.cpp / llama-server:   http://127.0.0.1:8080
# Ollama:                     http://127.0.0.1:11434
# LM Studio (OpenAI-compat):  http://127.0.0.1:1234/v1
