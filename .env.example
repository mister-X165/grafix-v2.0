# Скопируй в .env и подставь значения (файл .env в .gitignore)

# LM Studio / Gemma
# LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LM_STUDIO_MODEL=
# LM_STUDIO_TIMEOUT=300
# LM_STUDIO_MAX_TOKENS=500

# OpenRouter / DeepSeek 3.2
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v3.2
OPENROUTER_MODEL_V4=deepseek/deepseek-v4-pro
# Reasoning (thinking) for DeepSeek 3.2 / V4 Pro — on by default
# OPENROUTER_REASONING=1
# OPENROUTER_REASONING_EFFORT=high
# For extract: medium leaves more room for the JSON answer
# OPENROUTER_EXTRACT_REASONING_EFFORT=medium
# OPENROUTER_TIMEOUT=300
# OPENROUTER_MAX_TOKENS=1200
# OPENROUTER_EXTRACT_MAX_TOKENS=4000
# On Windows, if Python gets WinError 10060 to the proxy, set:
# OPENROUTER_HTTP=curl

# GigaChat (Sber) — Auth key из Studio (Base64 ClientID:Secret)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# GIGACHAT_BASE_URL=https://api.giga.chat/v1
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_VERIFY_SSL=1
# GIGACHAT_TIMEOUT=300
# GIGACHAT_MAX_TOKENS=4000
# GIGACHAT_EXTRACT_MAX_TOKENS=16000
# Reasoning: model_options.reasoning.effort (по умолчанию medium)
# GIGACHAT_REASONING=1
# GIGACHAT_REASONING_EFFORT=medium
